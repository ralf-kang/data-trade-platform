// 정형(구조화) 데이터 스키마 — PostgreSQL
//
// 이 스키마는 "고정된 구조로 다루기 쉬운" 데이터만 담당한다:
//   - 관리자 계정, 권한
//   - 폼의 운영/배포 메타데이터(상태, 소유자, 조회/제출 카운터)
//   - 감사 로그, 양식 공유 워크플로우
//
// 반대로 "양식마다 필드 구성이 바뀌고, 필드 구성에 따라 제출 데이터의 컬럼 수/타입이
// 계속 확장되는" 비정형 데이터(폼 필드 정의, 제출 데이터 본문)는 Elasticsearch가 담당한다.
// 매핑/색인 로직은 src/lib/elasticsearch.ts 참고.
//
// FormRegistry.id 는 Elasticsearch의 webreport-form-templates 문서 id(예: "f-101")와
// 동일한 값을 공유하는 비즈니스 키로, 두 저장소를 이어주는 조인 포인트다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 사용자 역할 — 응답자와 관리자는 별개의 사람이 아니다(총무팀 담당자도 인사팀 설문엔
// 응답자다). 그래서 계정 테이블을 나누지 않고 User 하나에 역할을 여러 개 부여한다.
//   Guest 는 별도 역할이 아니라 "인증되지 않은 접근"을 뜻하므로 여기에 없다.
enum RoleType {
  MEMBER // 임직원 — 응답, 마이페이지
  AUTHOR // 양식 제작자 — 양식 CRUD, 자기 양식 데이터
  PLATFORM_ADMIN // 플랫폼 관리자 — 정책·계정·거버넌스
}

// 계정 상태 — 퇴사자와 정지 계정은 다르게 다뤄야 한다.
// 퇴사자는 로그인만 막고 과거 응답·소유 이력은 보존해야 하며(감사/데이터베이스제작자 권리),
// 정지는 제재이므로 해제될 수 있다. 불리언 하나로는 이 둘이 구분되지 않는다.
enum UserStatus {
  ACTIVE
  SUSPENDED // 제재로 인한 정지
  LEFT // 퇴사/이탈 — LDAP 동기화에서 사라진 경우 포함
}

// 계정 출처 — LDAP 동기화 계정은 이름/부서 등을 로컬에서 수정해도 다음 동기화 때
// 덮어써지므로, 화면에서 편집 가능 여부를 가르기 위해 구분한다.
enum UserSource {
  LOCAL
  LDAP
}

enum FormStatus {
  OPEN
  CLOSED
}

// 양식지가 요구하는 응답자 신원 수준.
//   ANONYMOUS     : 신원을 수집하지 않는다(기존 동작 = 기본값).
//   IDENTIFIED    : 개인화 링크 토큰 필수.
//   AUTHENTICATED : 로그인 필수.
//   MIXED         : 토큰이 있으면 식별, 없으면 익명으로 수집.
//                   공용 QR(익명)과 개인 링크(식별)를 함께 운영할 때 쓴다.
enum IdentityMode {
  ANONYMOUS
  IDENTIFIED
  AUTHENTICATED
  MIXED
}

// 양식지 설계 단계 — 외부 API 연동의 "계약(contract)"이 언제부터 유효한지를 가른다.
//   DRAFT     : 아직 만드는 중. 필드 구성이 언제든 바뀔 수 있으므로 외부 API 쓰기를 막는다.
//   PUBLISHED : 확정됨. 이 시점의 필드 구성이 API 계약이 되고, 외부 시스템이 연동을 시작할 수 있다.
// 확정 후 필드를 수정하면 schemaVersion이 올라가고, 외부 연동 측이 변경을 감지할 수 있다.
enum FormLifecycle {
  DRAFT
  PUBLISHED
}

// API 키에 부여하는 권한 범위.
enum ApiScope {
  READ // 제출 데이터 조회(대량 포함)
  WRITE // 제출 데이터 입력(대량 포함)
  READ_WRITE
}

enum ShareRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditSeverity {
  info
  warning
  critical
}

// 수집 회차 상태.
//   SCHEDULED : 생성됐으나 아직 시작 전. 스케줄러가 미리 만들어 둔다.
//   OPEN      : 응답 수집 중
//   CLOSED    : 마감 — 응답 불가. 익명 버퍼 잔여분이 이 시점에 정리된다.
enum CampaignStatus {
  SCHEDULED
  OPEN
  CLOSED
}

// 회차 자동 생성 주기.
enum RecurrenceFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

// 포인트 원장 항목의 상태. 적립은 응답 즉시 확정되지 않고 검증·정산을 거친다.
//   PENDING  : 적립 예정 — 품질검증/정산 대기
//   APPROVED : 지급 확정 (아직 잔액 미반영)
//   PAID     : 지급 완료 — 잔액에 반영되는 것은 이 상태뿐
//   REJECTED : 미지급 — 사유 필수
//   CANCELED : 지급 후 회수. 금액을 수정하지 않고 반대 부호의 새 행을 추가한다.
enum PointStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELED
}

// 회차 대상자 산정 방식.
enum TargetingMode {
  ALL_MEMBERS // 전체 임직원
  DEPARTMENTS // 특정 부서
  EXPLICIT // 명시적 사용자 목록
  PREVIOUS_RESPONDENTS // 직전 회차 응답자 — 최신화 요청에 적합
}

// 개인정보 취급자(제작 자격) 상태.
//   PENDING   : 신청됨 — 승인 대기
//   APPROVED  : 승인 — 제작·배포 가능
//   SUSPENDED : 교육 유효기간 경과 등. 신규 제작·배포는 막되 기존 데이터 조회는 유지한다 —
//               이미 걷은 데이터에는 응답자 후속 조치 의무가 남아 있어 조회까지 끊으면 안 된다.
//   EXPIRED   : 재승인 주기 경과
//   REVOKED   : 해제 — 퇴사·직무변경·위반
enum AuthorAuthStatus {
  PENDING
  APPROVED
  SUSPENDED
  EXPIRED
  REVOKED
}

// 배포 범위 승인 상태.
enum FormApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// 마이페이지 "포인트" 화면의 노출 범위. 보상 제도가 준비 중인 동안 일반 임직원에게는
// 감추고 관리자에게만 개발 상태를 보여줄 수 있게 한다.
enum RewardVisibility {
  HIDDEN // 아무에게도 보이지 않음
  ADMIN_ONLY // 플랫폼 관리자에게만 "개발 중" 배지와 함께 노출
  ALL_MEMBERS // 전체 공개 — 보상 제도 정식 운영
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String
  // 로컬 계정의 비밀번호 해시. LDAP 계정은 원격에서 인증하므로 사용하지 않는다.
  password String?

  // 조직 정보 — 부서별 코호트 분석, 소수 응답 보호(k-익명성) 임계값, 부서 예산의 기준.
  employeeNo String? @unique // 사번 — LDAP/인사시스템 연동 키
  department String?
  position   String?

  status       UserStatus @default(ACTIVE)
  source       UserSource @default(LOCAL)
  // LDAP 계정의 원본 식별자 — 이름/부서가 바뀌어도 같은 사람임을 추적한다.
  ldapDn       String?    @unique
  lastSyncedAt DateTime?

  // 대량 추출(CSV) 허용 여부 — 슈퍼관리자가 개인적 유용 등을 우려해 개별 제한할 수 있다.
  // false이면 /submissions/export 요청이 거부된다 (src/lib/services/submissionService.ts).
  canBulkExport Boolean @default(true)

  // 양식지 관계(온톨로지) 캔버스 최초 진입 시 재식별 위험 안내에 동의한 시각.
  // privacyWarningAck와 같은 패턴 — 최초 1회만 모달을 띄우고, 이후엔 설정에서 재열람만 가능.
  // (docs/양식지-관계-온톨로지-설계.md §2-5)
  ontologyConsentAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  roles                      UserRole[]
  respondentTokens           RespondentToken[]
  campaignTargets            CampaignTarget[]
  campaignParticipations     CampaignParticipation[]
  pointLedger                PointLedger[]
  authorAuthorization        AuthorAuthorization?
  formsOwned                 FormRegistry[]                @relation("FormOwner")
  shareRequestsSent          ShareRequest[]                @relation("ShareRequestFrom")
  shareRequestsReceived      ShareRequest[]                @relation("ShareRequestTo")
  notifications              AdminNotification[]
  correctionRequestsReceived SubmissionCorrectionRequest[]

  @@index([department])
  @@index([source, status])
  @@map("users")
}

// 다중 역할 + 양식 단위 위임.
// scopeFormId를 지정하면 해당 양식에서만 유효한 권한이 되어, 담당자 인수인계나
// 휴가 대행을 expiresAt과 함께 표현할 수 있다.
model UserRole {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RoleType

  scopeFormId String?
  scopeForm   FormRegistry? @relation(fields: [scopeFormId], references: [id], onDelete: Cascade)

  // 부여자는 email로 남긴다 — 부여자 계정이 삭제되어도 이력이 보존되어야 한다.
  grantedBy String
  grantedAt DateTime  @default(now())
  // 한시적 위임. 만료된 행은 권한 없음으로 취급하되 감사 이력을 위해 삭제하지 않는다.
  expiresAt DateTime?

  @@unique([userId, role, scopeFormId])
  @@index([userId])
  @@index([scopeFormId])
  @@map("user_roles")
}

// 폼의 "운영" 측면(정형) — 실제 제목/설명/필드 구성(비정형)은 Elasticsearch 문서를 참고.
model FormRegistry {
  id                 String        @id // 비즈니스 키: "f-101" 등. ES 문서 id와 동일하게 유지.
  status             FormStatus    @default(OPEN)
  ownerId            String?
  owner              User?         @relation("FormOwner", fields: [ownerId], references: [id])
  // 운영 서버 기본 배포 URL — "/q/{id}" 고정값. 관리자 화면에서 수정/삭제할 수 없도록
  // API 계층(formService)에서 보호하고, 별도 활성화 기간만 이 레코드로 제어한다.
  deployUrl          String?
  // 양식지 활성화 기간(선택) — 설정 시 이 기간 밖에서는 공개 응답 페이지 접근이 거부된다.
  startsAt           DateTime?
  expiresAt          DateTime?
  // 설계 단계 — DRAFT인 동안에는 외부 API 쓰기를 거부한다(필드 구성이 계속 바뀌므로).
  lifecycle          FormLifecycle @default(DRAFT)
  // 확정(PUBLISHED) 이후 필드 구성을 바꿀 때마다 1씩 올라간다. 외부 연동 측이
  // 계약 변경을 감지하는 기준값이며, API 응답 헤더(X-Form-Schema-Version)로도 노출한다.
  schemaVersion      Int           @default(1)
  publishedAt        DateTime?
  // 이 양식이 요구하는 응답자 신원 수준. 기본 ANONYMOUS이므로 기존 양식의 동작은 바뀌지 않는다.
  identityMode       IdentityMode  @default(ANONYMOUS)
  // 익명 문항 결과를 공개하기 위한 최소 응답 수(2단계). null이면 시스템 기본값을 따른다.
  anonymityThreshold Int?

  // ── 마스킹 계층 ──
  // 제작 시점에 제작자가 개인정보 취급 자격을 갖고 있었는지. 제작 시점에 고정하고
  // 이후 바꾸지 않는다 — 사후에 자격을 얻어도 과거 데이터가 소급 정당화되면
  // "일단 걷고 나중에 자격 따면 된다"가 학습된다.
  authorHadPrivacyAuth Boolean   @default(false)
  // 예외 해제 — 슈퍼관리자 검토 + 사유 기록을 거친 명시적 승인으로만 값이 채워진다.
  maskingExemptedBy    String?
  maskingExemptedAt    DateTime?
  maskingExemptReason  String?

  // privacy-consent 컴포넌트 포함 여부로 자동 설정된다(자진신고 아님). 개인정보
  // 영향평가·동의서 목록 작성의 기준이 된다.
  collectsPersonalData Boolean @default(false)
  // 조합 위험 경고를 확인하고 진행한 사유 — 감사 시 판단 근거로 남긴다.
  privacyWarningAck    String?

  viewCount       Int      @default(0)
  submissionCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shareRequests      ShareRequest[]
  auditLogs          AuditLog[]
  notifications      AdminNotification[]
  apiKeys            ApiKey[]
  scopedRoles        UserRole[]
  respondentTokens   RespondentToken[]
  anonymousBuffer    AnonymousResponseBuffer[]
  campaigns          Campaign[]
  schedule           CampaignSchedule?
  correctionRequests SubmissionCorrectionRequest[]

  @@map("form_registry")
}

// 수집 회차. 같은 양식으로 반복 수집할 때 각 회차를 나타낸다.
// 일회성 수집도 회차 1개로 표현되므로, 3단계 이후 모든 제출은 반드시 어떤 회차엔가 속한다.
//
// 이 모델이 있어야 "분기마다 양식을 새로 만드는" 반복 업무가 사라지고,
// 회차가 곧 시계열 축이 되어 추세 분석이 가능해진다.
model Campaign {
  id     String       @id @default(cuid())
  formId String
  form   FormRegistry @relation(fields: [formId], references: [id], onDelete: Cascade)

  name     String // "2026 Q1 정기조사"
  sequence Int // 회차 번호. 자동 생성 시 직전 회차 +1.

  startsAt DateTime
  endsAt   DateTime?
  status   CampaignStatus @default(SCHEDULED)

  // 회차 시작 시점의 폼 스키마 버전을 고정한다. 이후 양식이 수정되어도 이 회차
  // 데이터의 해석 기준은 바뀌지 않아야 한다 — 5점 척도로 걷은 회차를 7점 척도
  // 기준으로 읽으면 없는 추세가 만들어진다.
  schemaVersion Int

  // 회차별 익명 임계값(2단계). Q1 3건 + Q2 3건을 6건으로 합산하면 안 되므로
  // 임계값 판정은 반드시 회차 단위로 이루어진다.
  anonymityThreshold Int?

  // 자동 생성분인지 — 스케줄 변경 시 영향 범위를 판단하는 근거.
  autoCreated Boolean @default(false)

  // 배포 범위. 부서 배포는 무승인, 전사 배포는 슈퍼관리자 승인이 필요하다(기본값).
  // 여러 부서가 동시에 전사 발송을 남발하면 임직원 피로도로 전체 응답률이 무너지므로,
  // 파급력이 큰 범위만 승인 절차를 둔다.
  distributionScope String               @default("DEPARTMENT") // "DEPARTMENT" | "COMPANY_WIDE"
  approvalRequest   FormApprovalRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets         CampaignTarget[]
  participations  CampaignParticipation[]
  anonymousBuffer AnonymousResponseBuffer[]

  @@unique([formId, sequence])
  @@index([formId, status])
  @@index([status, endsAt])
  @@map("campaigns")
}

// 전사 배포 승인 요청. 회차가 COMPANY_WIDE로 대상자를 지정하려 할 때 생성되며,
// 승인 전에는 대상자 지정(링크 발급)이 진행되지 않는다.
model FormApprovalRequest {
  id         String   @id @default(cuid())
  campaignId String   @unique
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  status      FormApprovalStatus @default(PENDING)
  requestedBy String // 신청한 관리자 email
  requestedAt DateTime           @default(now())
  reason      String // 전사 배포가 필요한 이유

  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?

  @@map("form_approval_requests")
}

// 양식지 간 관계(온톨로지) — 사용자가 두 양식지의 문항이 같은 키값을 담고 있는지
// 테스트하고 선언한 결과. 실제 매칭 레코드는 여기 저장하지 않는다(질의 시 계산) —
// 저장하면 마스킹을 우회하는 비마스킹 사본이 되기 때문이다.
// (docs/양식지-관계-온톨로지-설계.md §3 — 슈퍼관리자 전용 기능, §5-2)
enum FormLinkCardinality {
  ONE_TO_ONE
  ONE_TO_MANY
  MANY_TO_ONE
  MANY_TO_MANY
}

enum FormLinkVisibility {
  PRIVATE
  PENDING
  SHARED
}

model FormLink {
  id           String @id @default(cuid())
  leftFormId   String
  leftFieldId  String
  rightFormId  String
  rightFieldId String

  name        String // "이 직원이 제출한 만족도조사"
  reverseName String // "이 응답을 제출한 직원"

  cardinality FormLinkCardinality

  /// 정규화 규칙 (trim/stripSeparator/lowercase/stripLeadingZero/nfc ...)
  normalization Json

  /// leftField/rightField 중 하나라도 FormField.personalIdentifier=true면 true.
  /// 시스템이 값으로 추론하지 않는다 — 제작자 태그를 그대로 반영한 값. 블러 처리 판정 기준.
  isPersonalKey Boolean @default(false)

  /// 현재는 슈퍼관리자만 이 기능을 쓰므로(§5-2) 사실상 항상 PRIVATE다.
  visibility FormLinkVisibility @default(PRIVATE)
  approvedBy String?
  approvedAt DateTime?

  createdBy   String
  createdAt   DateTime @default(now())
  description String?

  @@index([leftFormId])
  @@index([rightFormId])
  @@map("form_links")
}

// 데이터 품질(결측치·이상치) 조회 화면(§docs/데이터품질-검증구간-설계.md §5 순위 5)에서
// 양식 제작자가 특정 제출 건에 대해 응답자에게 수정을 요청한 기록.
// 제출 데이터 자체(비정형, ES)는 여기 복제하지 않는다 — submissionId로만 참조한다.
enum CorrectionRequestIssueType {
  MISSING // 결측치
  OUTLIER // 이상치
  OTHER
}

enum CorrectionRequestStatus {
  PENDING
  RESOLVED // 응답자가 재제출(수정)함
  DISMISSED // 관리자가 취소
}

model SubmissionCorrectionRequest {
  id           String       @id @default(cuid())
  formId       String
  form         FormRegistry @relation(fields: [formId], references: [id], onDelete: Cascade)
  campaignId   String?
  submissionId String // Elasticsearch 제출 문서 id
  fieldId      String? // null = 특정 문항이 아니라 응답 전체에 대한 요청
  /// 식별 응답인 경우에만 채워진다 — 익명 응답은 정정 요청 대상이 될 수 없다(응답자를 특정할 수 없음).
  respondentId String?
  respondent   User?        @relation(fields: [respondentId], references: [id])

  issueType CorrectionRequestIssueType
  reason    String // 관리자가 남기는 구체적 사유

  requestedBy String // 요청한 관리자 email
  requestedAt DateTime @default(now())

  status     CorrectionRequestStatus @default(PENDING)
  resolvedAt DateTime?

  @@index([formId])
  @@index([respondentId, status])
  @@map("submission_correction_requests")
}

// 회차 자동 생성 규칙. 이것이 있으면 다음 회차를 미리 만들어 두고 대상자에게
// 개인화 링크를 발송한다 — 제작자는 양식을 한 번만 만들면 된다.
model CampaignSchedule {
  id     String       @id @default(cuid())
  formId String       @unique
  form   FormRegistry @relation(fields: [formId], references: [id], onDelete: Cascade)

  enabled   Boolean             @default(true)
  frequency RecurrenceFrequency

  startDayOfPeriod   Int   @default(1) // 주기 시작 후 며칠째에 회차를 열지
  durationDays       Int   @default(14) // 회차가 열려 있는 기간
  reminderDaysBefore Int[] @default([7, 1]) // 마감 며칠 전에 미응답자 리마인드

  // 회차는 시작 시각이 아니라 그 전에 미리 만든다 — 시작 시각에 만들면 스케줄러가
  // 잠깐 죽었을 때 회차가 통째로 누락된다.
  nextRunAt    DateTime?
  lastRunAt    DateTime?
  nameTemplate String    @default("{year} {quarter} 정기조사")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaign_schedules")
}

// 이 회차에 응답을 요청받은 사람. 개인화 링크(RespondentToken)와 짝을 이룬다.
// 발송·열람·응답 시점을 나눠 남기는 이유는, 응답률이 낮을 때 무엇을 고쳐야 하는지
// (발송 채널인지, 양식 자체인지) 가리기 위해서다.
model CampaignTarget {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenId String? @unique // 발급된 개인화 링크. 재발송 시 교체된다.

  invitedAt     DateTime?
  deliveredAt   DateTime?
  openedAt      DateTime?
  respondedAt   DateTime?
  remindedAt    DateTime?
  reminderCount Int       @default(0)

  @@unique([campaignId, userId])
  @@index([campaignId, respondedAt])
  @@map("campaign_targets")
}

// 회차 참여 기록. 제출 "내용"은 Elasticsearch에 있고 여기에는 "참여했다는 사실"만 둔다.
//
// 이 테이블이 정형 저장소에 필요한 이유:
//   1. ES에는 유니크 제약이 없어 "회차당 1인 1응답"을 강제할 수 없다.
//   2. 보상 지급(7단계)의 기준이 되는 사실은 정산·감사가 가능한 곳에 있어야 한다.
//   3. 익명 문항만 있는 양식(2단계)에서도 참여 사실은 남아야 한다 — 내용은 익명
//      인덱스로 분리되지만 "누가 참여했는가"는 보상에 필요하다.
// 포인트 원장 — append-only.
//
// 잔액 컬럼을 두고 UPDATE 하는 방식은 쓰지 않는다. 사내 포인트가 현금성 가치를 가지면
// 이것은 회계 장부이며, 적립·차감·취소가 모두 남아야 분쟁과 감사에 대응할 수 있다.
// 회수가 필요하면 기존 행의 delta를 고치지 않고 반대 부호의 새 행을 추가한다.
//
// 잔액 = SUM(delta) WHERE status = 'PAID'
model PointLedger {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 부호 있는 증감. 이 값은 어떤 경우에도 수정하지 않는다.
  delta        Int
  reason       String
  status       PointStatus @default(PENDING)
  /// 미지급/취소 사유 — 응답자에게는 범주 수준으로만 안내한다.
  statusReason String?

  /// 적립 근거가 된 회차(있는 경우).
  campaignId     String?
  /// 응답 시점에 약속된 보상 규칙의 스냅샷. 정책이 나중에 바뀌어도
  /// "응답할 때 10P라고 했으니 10P를 준다"를 증명할 수 있어야 한다.
  policySnapshot Json?

  createdAt DateTime  @default(now())
  /// 상태 전이 시각. delta는 불변이지만 상태는 정산 과정에서 진행된다.
  settledAt DateTime?

  @@index([userId, status])
  @@index([campaignId])
  @@map("point_ledger")
}

model CampaignParticipation {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  submissionId String // ES 식별 문서의 submissionId
  submittedAt  DateTime  @default(now())
  revision     Int       @default(0) // 최초 제출이 0, 수정할 때마다 증가
  lastEditedAt DateTime?

  // 기한 내 응답 여부 — 조기 응답 보상(7단계)과 적시성 지표의 근거.
  onTime Boolean @default(true)

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_participations")
}

// 개인화 응답 링크 — 로그인을 강제하지 않으면서 응답자를 식별하기 위한 토큰.
//
// 원문은 저장하지 않는다(ApiKey와 동일 원칙). 유출 시 피해를 줄이기 위해 SHA-256 해시만
// 보관하고, 목록에서 식별할 수 있도록 접두 일부만 평문으로 남긴다.
//
// 중요: 토큰이 URL 쿼리스트링에 실려 오면 브라우저 히스토리·Referer·웹서버 액세스 로그에
// 남는다. 그래서 응답 화면은 토큰을 받는 즉시 응답 세션 쿠키로 교환하고 URL에서 제거한다
// (src/lib/respondent.ts).
model RespondentToken {
  id          String @id @default(cuid())
  tokenHash   String @unique // SHA-256(원문)
  tokenPrefix String // 접두 12자 — 목록 식별용

  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  formId     String
  form       FormRegistry @relation(fields: [formId], references: [id], onDelete: Cascade)
  // 어느 회차의 응답 요청인지. 링크로 들어오면 이 회차로 제출이 귀속된다.
  campaignId String?

  // 만료는 필수다 — 무기한 토큰은 유출 시 영구적인 위험이 된다.
  expiresAt DateTime
  // 기본 false 권장: 제출 도중 창을 닫으면 다시 못 들어오게 되어 재발급 요청이 폭주한다.
  // 중복 제출 방지는 회차별 참여 기록(3단계)으로 처리하는 편이 안전하다.
  singleUse Boolean   @default(false)
  usedAt    DateTime?
  revokedAt DateTime?

  // 발송/열람 추적 — 응답률이 낮을 때 원인(미발송/미열람/이탈)을 가른다.
  issuedBy    String
  issuedAt    DateTime  @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?

  @@index([userId, formId])
  @@index([formId, expiresAt])
  @@map("respondent_tokens")
}

// 익명 응답의 임시 보관소(2단계).
//
// 익명 문항 응답을 즉시 색인하지 않고 여기에 모았다가 임계값(k)에 도달하면 순서를 섞어
// 한꺼번에 적재한다. 즉시 쓰면 "저장 순서 = 응답 순서"가 되어, 식별 문서의 제출 시각과
// 나란히 놓는 것만으로 누가 무엇을 답했는지 복원되기 때문이다.
//
// payload는 암호화해 둔다 — 버퍼에 머무는 짧은 시간에도 DB를 직접 들여다보는 것만으로는
// 내용을 읽을 수 없어야 한다.
model AnonymousResponseBuffer {
  id         String       @id @default(cuid())
  formId     String
  form       FormRegistry @relation(fields: [formId], references: [id], onDelete: Cascade)
  // 회차별로 버퍼와 임계값이 분리되어야 한다 — Q1 3건과 Q2 3건을 6건으로 세어
  // 임계값을 채우면 각 회차는 여전히 소수 응답인데 공개되어 버린다.
  campaignId String?
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // AES-256-GCM 암호문 (src/lib/crypto.ts)
  payloadEncrypted String
  // 절삭된 제출 시각(기본 1시간 단위). 정확한 시각은 저장하지 않는다.
  bucketAt         DateTime
  schemaVersion    Int

  createdAt DateTime @default(now())

  @@index([formId])
  @@index([campaignId])
  @@map("anonymous_response_buffer")
}

// 외부 시스템이 제출 데이터를 대량 조회/입력할 때 사용하는 API 키.
//
// 원문 키는 저장하지 않는다(생성 시 1회만 화면에 노출). 대신 SHA-256 해시만 보관하고,
// 목록 화면에서 어떤 키인지 식별할 수 있도록 접두 8자(prefix)만 평문으로 남긴다.
model ApiKey {
  id              String       @id @default(cuid())
  formId          String
  form            FormRegistry @relation(fields: [formId], references: [id], onDelete: Cascade)
  name            String // 사람이 알아볼 용도 ("외부 파트너사 A 연동" 등)
  keyPrefix       String // 평문 접두 8자 — 목록에서 키 식별용
  keyHash         String       @unique // SHA-256(원문키)
  scope           ApiScope     @default(READ)
  // 분당 허용 요청 수 — 대량 추출 남용을 막기 위한 키 단위 상한.
  rateLimitPerMin Int          @default(60)
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  useCount        Int          @default(0)
  createdBy       String // 발급한 관리자 이메일
  createdAt       DateTime     @default(now())

  @@index([formId])
  @@map("api_keys")
}

model AuditLog {
  id        String        @id @default(cuid())
  time      DateTime      @default(now())
  userEmail String
  action    String
  formId    String?
  form      FormRegistry? @relation(fields: [formId], references: [id])
  target    String
  details   String
  severity  AuditSeverity @default(info)

  @@index([formId])
  @@map("audit_logs")
}

// 관리자에게 보내는 인앱 알림 — 특히 제출 데이터 이상치 감지 시 양식 소유자에게 발송된다
// (요구사항: "관리자는 관련 이상치 데이터에 대해서 보고/알림을 받을 수 있어야 함").
model AdminNotification {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  formId    String?
  form      FormRegistry? @relation(fields: [formId], references: [id])
  type      String // 'ANOMALY' | 'SHARE_REQUEST' | 'OWNERSHIP_CHANGE' 등
  message   String
  severity  AuditSeverity @default(info)
  read      Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([userId, read])
  @@map("admin_notifications")
}

// 시스템 전역 설정(싱글턴) — 예: QR/URL 생성에 쓰이는 공개 기본 도메인.
// 슈퍼관리자 시스템 환경 설정(/super-admin/settings) 화면에서만 수정 가능.
model SystemConfig {
  id                        String  @id @default("default")
  // QR 코드 / 배포 URL 안내에 사용할 운영 서버의 공개 기본 URL (예: https://forms.company.com).
  // 미설정 시 요청 Origin으로 대체한다.
  publicBaseUrl             String?
  // 익명 응답 결과를 공개하기 위한 최소 응답 수(2단계). 양식별로 override 가능.
  // 이보다 적으면 소수 응답의 조합으로 개인이 특정될 수 있으므로 조회를 막는다.
  defaultAnonymityThreshold Int     @default(5)

  /// 마이페이지 포인트 화면의 노출 범위. 보상 제도가 준비 중인 동안은 ADMIN_ONLY로
  /// 두어, 일반 임직원에게는 감추고 관리자만 "개발 중" 상태로 확인할 수 있게 한다.
  rewardVisibility RewardVisibility @default(ADMIN_ONLY)

  /// 응답자 1인이 한 주에 받을 수 있는 회차 초대 상한. 여러 부서가 동시에 발송하면
  /// 특정 인원에게 요청이 몰려 피로도로 전체 응답률이 무너질 수 있어 상한을 둔다.
  /// 기본값은 조정 가능하며, 대상자 지정(upsertTargets) 시점에 이 값을 기준으로 검사한다.
  maxWeeklyInvitesPerUser Int @default(3)

  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// 개인정보 취급자(제작 자격) — 역할(AUTHOR)과 별개의 심사 절차.
//
// UserRole.AUTHOR는 "양식을 만들 수 있다"는 기능 권한일 뿐이다. 양식 제작자는 수집
// 항목을 정하고 응답 데이터를 열람·추출할 수 있어 사실상 개인정보 취급자가 되므로,
// 기능 권한과는 별도로 목적·서약·교육을 요구하는 자격 심사를 둔다.
//
// LDAP defaultRole은 MEMBER로 유지한다 — 동기화된 계정에 AUTHOR를 자동 부여하면
// 심사 없이 전 임직원이 개인정보 취급자가 되어 이 모델 자체가 무의미해진다.
model AuthorAuthorization {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status AuthorAuthStatus @default(PENDING)

  // ── 신청 시 기재 ──
  purpose          String // 수집 목적
  plannedDataItems String // 수집 예정 항목

  // ── 승인 시 기록 ──
  pledgeAcceptedAt    DateTime? // 서약 동의 시각
  trainingCompletedAt DateTime? // 개인정보 교육 이수 시각
  trainingValidUntil  DateTime? // 교육 유효기간 — 경과 시 SUSPENDED (기본 12개월)
  reauthorizeBy       DateTime? // 재승인 주기 — 경과 시 EXPIRED (기본 24개월)

  reviewedBy    String? // 승인/거부/해제 처리자 email
  reviewedAt    DateTime?
  // 해제(REVOKED) 사유 — 퇴사·직무변경·위반 등. 감사 근거로 남긴다.
  revokedReason String?

  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("author_authorizations")
}

// LDAP 서버 접속 암호화 방식.
//   NONE     : 평문(389). 사내 폐쇄망이 아니면 사용하지 말 것 — 자격증명이 그대로 흐른다.
//   LDAPS    : 전용 SSL 포트(636)로 처음부터 암호화.
//   STARTTLS : 389로 연결한 뒤 TLS로 승격.
enum LdapEncryption {
  NONE
  LDAPS
  STARTTLS
}

// LDAP(Active Directory 포함) 연동 설정 — 싱글턴.
//
// 슈퍼관리자 시스템 환경 설정 화면에서만 수정 가능하며, bindPassword는 평문으로 저장하지
// 않고 AES-256-GCM으로 암호화해 보관한다(src/lib/crypto.ts). 화면에도 다시 노출하지 않는다.
model LdapConfig {
  id      String  @id @default("default")
  enabled Boolean @default(false)

  // ── 연결 ──
  host       String?
  port       Int            @default(389)
  encryption LdapEncryption @default(STARTTLS)
  // 사내 자체서명 인증서를 쓰는 경우에만 false. 운영에서 끄면 중간자 공격에 노출된다.
  verifyCert Boolean        @default(true)
  timeoutMs  Int            @default(5000)

  // ── 검색용 바인딩 계정 ──
  bindDn                String?
  bindPasswordEncrypted String? // AES-256-GCM 암호문. 절대 평문 저장/응답 금지.

  // ── 사용자 검색 ──
  baseDn           String?
  userSearchFilter String  @default("(&(objectClass=person)(uid={username}))")
  userSearchScope  String  @default("sub") // base | one | sub

  // ── 속성 매핑 (LDAP 속성명 → User 필드) ──
  attrEmail      String  @default("mail")
  attrName       String  @default("cn")
  attrEmployeeNo String? @default("employeeNumber")
  attrDepartment String? @default("departmentNumber")
  attrPosition   String? @default("title")

  // ── 동기화 정책 ──
  // 동기화로 새로 만들어진 계정에 기본 부여할 역할.
  defaultRole       RoleType @default(MEMBER)
  // LDAP 검색 결과에서 사라진 계정 처리 — 삭제하지 않고 LEFT로 전환한다.
  // 과거 응답·소유 이력을 보존해야 하기 때문(감사/데이터베이스제작자 권리).
  deactivateMissing Boolean  @default(true)

  lastSyncAt     DateTime?
  lastSyncResult String? // 마지막 동기화 요약 (JSON 문자열)
  updatedAt      DateTime  @updatedAt

  @@map("ldap_config")
}

model ShareRequest {
  id         String             @id @default(cuid())
  formId     String
  form       FormRegistry       @relation(fields: [formId], references: [id])
  fromUserId String
  fromUser   User               @relation("ShareRequestFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User               @relation("ShareRequestTo", fields: [toUserId], references: [id])
  status     ShareRequestStatus @default(PENDING)
  createdAt  DateTime           @default(now())

  @@index([formId])
  @@map("share_requests")
}

// ---------------------------------------------------------------------------
// 데이터베이스제작자 보호 (저작권법 제4장, 제91조~제98조)
// ---------------------------------------------------------------------------
// 저작권법상 "데이터베이스제작자"는 소재의 갱신·검증·보충에 인적·물적으로 상당한
// 투자를 한 자를 말하며(제2조 20호), 그 보호기간은 데이터베이스의 제작을 완료한
// 때로부터 5년이고, 상당한 투자에 의한 갱신 등이 있으면 그 갱신 부분에 한해
// 갱신 시점부터 다시 5년이 기산된다(제95조). 이 사실관계(제작완료일/갱신이력)를
// 소송·행정 절차에서 입증하려면 "언제, 무엇을, 얼마나" 갱신했는지가 구조화된
// 형태로 기록되어 있어야 하므로 별도 정형 테이블로 관리한다.
model DatabaseRegistration {
  id                    String   @id @default(cuid())
  // 데이터베이스제작자(제2조 20호) — 상당한 투자를 한 주체
  producerName          String
  // 최초 제작 완료일 — 제95조 제1항 보호기간(5년)의 기산점
  completedAt           DateTime
  // 가장 최근의 "상당한 투자"에 의한 갱신일 — 제95조 제2항에 따라 해당 갱신
  // 부분에 대한 보호기간이 이 시점부터 다시 5년 기산된다.
  lastSubstantialUpdate DateTime
  // 상당한 투자의 구체적 내역 (인적/물적 투자 근거 — 분쟁 시 소명 자료)
  investmentDescription String
  createdAt             DateTime @default(now())

  updateLogs DatabaseUpdateLog[]

  @@map("database_registrations")
}

// 개별 "상당한 투자" 갱신 이벤트 이력 — 매 갱신마다 5년 보호기간이 새로 발생하는
// 부분을 특정할 수 있도록 건별로 남긴다 (제95조 제2항: "그 갱신 등을 한 부분에 대하여").
model DatabaseUpdateLog {
  id             String               @id @default(cuid())
  registrationId String
  registration   DatabaseRegistration @relation(fields: [registrationId], references: [id])
  occurredAt     DateTime             @default(now())
  // 갱신 대상 범위 (예: "f-101 제출 데이터 전체", "폼 필드 스키마 일괄 마이그레이션")
  scope          String
  description    String
  performedBy    String

  @@index([registrationId])
  @@map("database_update_logs")
}

// ---------------------------------------------------------------------------
// 외부 연결 목록 (docs/주소입력-지도분포-설계.md §3)
// ---------------------------------------------------------------------------
// 이 플랫폼이 외부로 나가는 모든 목적지의 단일 목록. 목적지를 코드에 하드코딩하면
// ① 환경마다 빌드를 다시 해야 하고 ② 설정 화면에 표시되는 값과 실제 호출 대상이
// 어긋날 수 있다. "화면에 보이는 값이 곧 실제 호출 대상"이어야 방화벽 허용 목록의
// 근거로 쓸 수 있으므로 DB에 둔다.
enum EndpointMode {
  BUILTIN // 내장(로컬) — 외부로 나가지 않는다
  EXTERNAL // 외부 서비스 호출
  DISABLED // 사용 안 함
}

model ExternalEndpointConfig {
  id            String       @id // "address-search" | "geocoding" | "map-tiles" ...
  label         String
  mode          EndpointMode @default(DISABLED)
  // mode=EXTERNAL일 때의 실제 목적지. 방화벽 허용 목록의 근거가 되는 값이다.
  scheme        String? // https | http
  host          String? // 호스트명 또는 IP
  port          Int?
  // 타일 URL 템플릿({z}/{x}/{y}) 등 용도별 부가 경로/템플릿
  pathTemplate  String?
  // 키가 필요한 서비스의 발급 키. 평문 노출 금지 — 응답 시 마스킹해서 내려보낸다.
  apiKey        String?
  // mode=BUILTIN일 때 — 내장 데이터의 기준일. 오프라인 갱신 체계에서는 갱신을 잊으면
  // "신규 항목이 검색되지 않음"으로 조용히 고장 나므로 기준일을 반드시 노출한다.
  dataAsOf      DateTime?
  lastCheckedAt DateTime?
  lastCheckOk   Boolean?
  note          String?
  updatedAt     DateTime     @updatedAt

  @@map("external_endpoint_config")
}
