// 정형(구조화) 데이터 스키마 — PostgreSQL
//
// 이 스키마는 "고정된 구조로 다루기 쉬운" 데이터만 담당한다:
//   - 관리자 계정, 권한
//   - 폼의 운영/배포 메타데이터(상태, 소유자, 조회/제출 카운터)
//   - 감사 로그, 양식 공유 워크플로우
//
// 반대로 "양식마다 필드 구성이 바뀌고, 필드 구성에 따라 제출 데이터의 컬럼 수/타입이
// 계속 확장되는" 비정형 데이터(폼 필드 정의, 제출 데이터 본문)는 Elasticsearch가 담당한다.
// 매핑/색인 로직은 src/lib/elasticsearch.ts 참고.
//
// FormRegistry.id 는 Elasticsearch의 webreport-form-templates 문서 id(예: "f-101")와
// 동일한 값을 공유하는 비즈니스 키로, 두 저장소를 이어주는 조인 포인트다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 사용자 역할 — 응답자와 관리자는 별개의 사람이 아니다(총무팀 담당자도 인사팀 설문엔
// 응답자다). 그래서 계정 테이블을 나누지 않고 User 하나에 역할을 여러 개 부여한다.
//   Guest 는 별도 역할이 아니라 "인증되지 않은 접근"을 뜻하므로 여기에 없다.
enum RoleType {
  MEMBER // 임직원 — 응답, 마이페이지
  AUTHOR // 양식 제작자 — 양식 CRUD, 자기 양식 데이터
  PLATFORM_ADMIN // 플랫폼 관리자 — 정책·계정·거버넌스
}

// 계정 상태 — 퇴사자와 정지 계정은 다르게 다뤄야 한다.
// 퇴사자는 로그인만 막고 과거 응답·소유 이력은 보존해야 하며(감사/데이터베이스제작자 권리),
// 정지는 제재이므로 해제될 수 있다. 불리언 하나로는 이 둘이 구분되지 않는다.
enum UserStatus {
  ACTIVE
  SUSPENDED // 제재로 인한 정지
  LEFT // 퇴사/이탈 — LDAP 동기화에서 사라진 경우 포함
}

// 계정 출처 — LDAP 동기화 계정은 이름/부서 등을 로컬에서 수정해도 다음 동기화 때
// 덮어써지므로, 화면에서 편집 가능 여부를 가르기 위해 구분한다.
enum UserSource {
  LOCAL
  LDAP
}

enum FormStatus {
  OPEN
  CLOSED
}

// 양식지가 요구하는 응답자 신원 수준.
//   ANONYMOUS     : 신원을 수집하지 않는다(기존 동작 = 기본값).
//   IDENTIFIED    : 개인화 링크 토큰 필수.
//   AUTHENTICATED : 로그인 필수.
//   MIXED         : 토큰이 있으면 식별, 없으면 익명으로 수집.
//                   공용 QR(익명)과 개인 링크(식별)를 함께 운영할 때 쓴다.
enum IdentityMode {
  ANONYMOUS
  IDENTIFIED
  AUTHENTICATED
  MIXED
}

// 양식지 설계 단계 — 외부 API 연동의 "계약(contract)"이 언제부터 유효한지를 가른다.
//   DRAFT     : 아직 만드는 중. 필드 구성이 언제든 바뀔 수 있으므로 외부 API 쓰기를 막는다.
//   PUBLISHED : 확정됨. 이 시점의 필드 구성이 API 계약이 되고, 외부 시스템이 연동을 시작할 수 있다.
// 확정 후 필드를 수정하면 schemaVersion이 올라가고, 외부 연동 측이 변경을 감지할 수 있다.
enum FormLifecycle {
  DRAFT
  PUBLISHED
}

// API 키에 부여하는 권한 범위.
enum ApiScope {
  READ // 제출 데이터 조회(대량 포함)
  WRITE // 제출 데이터 입력(대량 포함)
  READ_WRITE
}

enum ShareRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditSeverity {
  info
  warning
  critical
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  name     String
  // 로컬 계정의 비밀번호 해시. LDAP 계정은 원격에서 인증하므로 사용하지 않는다.
  password String?

  // 조직 정보 — 부서별 코호트 분석, 소수 응답 보호(k-익명성) 임계값, 부서 예산의 기준.
  employeeNo String? @unique // 사번 — LDAP/인사시스템 연동 키
  department String?
  position   String?

  status UserStatus @default(ACTIVE)
  source UserSource @default(LOCAL)
  // LDAP 계정의 원본 식별자 — 이름/부서가 바뀌어도 같은 사람임을 추적한다.
  ldapDn String? @unique
  lastSyncedAt DateTime?

  // 대량 추출(CSV) 허용 여부 — 슈퍼관리자가 개인적 유용 등을 우려해 개별 제한할 수 있다.
  // false이면 /submissions/export 요청이 거부된다 (src/lib/services/submissionService.ts).
  canBulkExport Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  roles                 UserRole[]
  respondentTokens      RespondentToken[]
  formsOwned            FormRegistry[]      @relation("FormOwner")
  shareRequestsSent     ShareRequest[]      @relation("ShareRequestFrom")
  shareRequestsReceived ShareRequest[]      @relation("ShareRequestTo")
  notifications         AdminNotification[]

  @@index([department])
  @@index([source, status])
  @@map("users")
}

// 다중 역할 + 양식 단위 위임.
// scopeFormId를 지정하면 해당 양식에서만 유효한 권한이 되어, 담당자 인수인계나
// 휴가 대행을 expiresAt과 함께 표현할 수 있다.
model UserRole {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RoleType

  scopeFormId String?
  scopeForm   FormRegistry? @relation(fields: [scopeFormId], references: [id], onDelete: Cascade)

  // 부여자는 email로 남긴다 — 부여자 계정이 삭제되어도 이력이 보존되어야 한다.
  grantedBy String
  grantedAt DateTime  @default(now())
  // 한시적 위임. 만료된 행은 권한 없음으로 취급하되 감사 이력을 위해 삭제하지 않는다.
  expiresAt DateTime?

  @@unique([userId, role, scopeFormId])
  @@index([userId])
  @@index([scopeFormId])
  @@map("user_roles")
}

// 폼의 "운영" 측면(정형) — 실제 제목/설명/필드 구성(비정형)은 Elasticsearch 문서를 참고.
model FormRegistry {
  id              String     @id // 비즈니스 키: "f-101" 등. ES 문서 id와 동일하게 유지.
  status          FormStatus @default(OPEN)
  ownerId         String?
  owner           User?      @relation("FormOwner", fields: [ownerId], references: [id])
  // 운영 서버 기본 배포 URL — "/q/{id}" 고정값. 관리자 화면에서 수정/삭제할 수 없도록
  // API 계층(formService)에서 보호하고, 별도 활성화 기간만 이 레코드로 제어한다.
  deployUrl       String?
  // 양식지 활성화 기간(선택) — 설정 시 이 기간 밖에서는 공개 응답 페이지 접근이 거부된다.
  startsAt        DateTime?
  expiresAt       DateTime?
  // 설계 단계 — DRAFT인 동안에는 외부 API 쓰기를 거부한다(필드 구성이 계속 바뀌므로).
  lifecycle       FormLifecycle @default(DRAFT)
  // 확정(PUBLISHED) 이후 필드 구성을 바꿀 때마다 1씩 올라간다. 외부 연동 측이
  // 계약 변경을 감지하는 기준값이며, API 응답 헤더(X-Form-Schema-Version)로도 노출한다.
  schemaVersion   Int        @default(1)
  publishedAt     DateTime?
  // 이 양식이 요구하는 응답자 신원 수준. 기본 ANONYMOUS이므로 기존 양식의 동작은 바뀌지 않는다.
  identityMode    IdentityMode @default(ANONYMOUS)
  // 익명 문항 결과를 공개하기 위한 최소 응답 수(2단계). null이면 시스템 기본값을 따른다.
  anonymityThreshold Int?
  viewCount       Int        @default(0)
  submissionCount Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  shareRequests ShareRequest[]
  auditLogs     AuditLog[]
  notifications AdminNotification[]
  apiKeys       ApiKey[]
  scopedRoles   UserRole[]
  respondentTokens RespondentToken[]
  anonymousBuffer  AnonymousResponseBuffer[]

  @@map("form_registry")
}

// 개인화 응답 링크 — 로그인을 강제하지 않으면서 응답자를 식별하기 위한 토큰.
//
// 원문은 저장하지 않는다(ApiKey와 동일 원칙). 유출 시 피해를 줄이기 위해 SHA-256 해시만
// 보관하고, 목록에서 식별할 수 있도록 접두 일부만 평문으로 남긴다.
//
// 중요: 토큰이 URL 쿼리스트링에 실려 오면 브라우저 히스토리·Referer·웹서버 액세스 로그에
// 남는다. 그래서 응답 화면은 토큰을 받는 즉시 응답 세션 쿠키로 교환하고 URL에서 제거한다
// (src/lib/respondent.ts).
model RespondentToken {
  id          String @id @default(cuid())
  tokenHash   String @unique // SHA-256(원문)
  tokenPrefix String // 접두 12자 — 목록 식별용

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  formId String
  form   FormRegistry @relation(fields: [formId], references: [id], onDelete: Cascade)

  // 만료는 필수다 — 무기한 토큰은 유출 시 영구적인 위험이 된다.
  expiresAt DateTime
  // 기본 false 권장: 제출 도중 창을 닫으면 다시 못 들어오게 되어 재발급 요청이 폭주한다.
  // 중복 제출 방지는 회차별 참여 기록(3단계)으로 처리하는 편이 안전하다.
  singleUse Boolean   @default(false)
  usedAt    DateTime?
  revokedAt DateTime?

  // 발송/열람 추적 — 응답률이 낮을 때 원인(미발송/미열람/이탈)을 가른다.
  issuedBy    String
  issuedAt    DateTime  @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?

  @@index([userId, formId])
  @@index([formId, expiresAt])
  @@map("respondent_tokens")
}

// 익명 응답의 임시 보관소(2단계).
//
// 익명 문항 응답을 즉시 색인하지 않고 여기에 모았다가 임계값(k)에 도달하면 순서를 섞어
// 한꺼번에 적재한다. 즉시 쓰면 "저장 순서 = 응답 순서"가 되어, 식별 문서의 제출 시각과
// 나란히 놓는 것만으로 누가 무엇을 답했는지 복원되기 때문이다.
//
// payload는 암호화해 둔다 — 버퍼에 머무는 짧은 시간에도 DB를 직접 들여다보는 것만으로는
// 내용을 읽을 수 없어야 한다.
model AnonymousResponseBuffer {
  id     String       @id @default(cuid())
  formId String
  form   FormRegistry @relation(fields: [formId], references: [id], onDelete: Cascade)

  // AES-256-GCM 암호문 (src/lib/crypto.ts)
  payloadEncrypted String
  // 절삭된 제출 시각(기본 1시간 단위). 정확한 시각은 저장하지 않는다.
  bucketAt      DateTime
  schemaVersion Int

  createdAt DateTime @default(now())

  @@index([formId])
  @@map("anonymous_response_buffer")
}

// 외부 시스템이 제출 데이터를 대량 조회/입력할 때 사용하는 API 키.
//
// 원문 키는 저장하지 않는다(생성 시 1회만 화면에 노출). 대신 SHA-256 해시만 보관하고,
// 목록 화면에서 어떤 키인지 식별할 수 있도록 접두 8자(prefix)만 평문으로 남긴다.
model ApiKey {
  id          String       @id @default(cuid())
  formId      String
  form        FormRegistry @relation(fields: [formId], references: [id], onDelete: Cascade)
  name        String // 사람이 알아볼 용도 ("외부 파트너사 A 연동" 등)
  keyPrefix   String // 평문 접두 8자 — 목록에서 키 식별용
  keyHash     String       @unique // SHA-256(원문키)
  scope       ApiScope     @default(READ)
  // 분당 허용 요청 수 — 대량 추출 남용을 막기 위한 키 단위 상한.
  rateLimitPerMin Int      @default(60)
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  useCount    Int          @default(0)
  createdBy   String // 발급한 관리자 이메일
  createdAt   DateTime     @default(now())

  @@index([formId])
  @@map("api_keys")
}

model AuditLog {
  id        String        @id @default(cuid())
  time      DateTime      @default(now())
  userEmail String
  action    String
  formId    String?
  form      FormRegistry? @relation(fields: [formId], references: [id])
  target    String
  details   String
  severity  AuditSeverity @default(info)

  @@index([formId])
  @@map("audit_logs")
}

// 관리자에게 보내는 인앱 알림 — 특히 제출 데이터 이상치 감지 시 양식 소유자에게 발송된다
// (요구사항: "관리자는 관련 이상치 데이터에 대해서 보고/알림을 받을 수 있어야 함").
model AdminNotification {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  formId    String?
  form      FormRegistry? @relation(fields: [formId], references: [id])
  type      String // 'ANOMALY' | 'SHARE_REQUEST' | 'OWNERSHIP_CHANGE' 등
  message   String
  severity  AuditSeverity @default(info)
  read      Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([userId, read])
  @@map("admin_notifications")
}

// 시스템 전역 설정(싱글턴) — 예: QR/URL 생성에 쓰이는 공개 기본 도메인.
// 슈퍼관리자 시스템 환경 설정(/super-admin/settings) 화면에서만 수정 가능.
model SystemConfig {
  id            String   @id @default("default")
  // QR 코드 / 배포 URL 안내에 사용할 운영 서버의 공개 기본 URL (예: https://forms.company.com).
  // 미설정 시 요청 Origin으로 대체한다.
  publicBaseUrl String?
  // 익명 응답 결과를 공개하기 위한 최소 응답 수(2단계). 양식별로 override 가능.
  // 이보다 적으면 소수 응답의 조합으로 개인이 특정될 수 있으므로 조회를 막는다.
  defaultAnonymityThreshold Int @default(5)
  updatedAt     DateTime @updatedAt

  @@map("system_config")
}

// LDAP 서버 접속 암호화 방식.
//   NONE     : 평문(389). 사내 폐쇄망이 아니면 사용하지 말 것 — 자격증명이 그대로 흐른다.
//   LDAPS    : 전용 SSL 포트(636)로 처음부터 암호화.
//   STARTTLS : 389로 연결한 뒤 TLS로 승격.
enum LdapEncryption {
  NONE
  LDAPS
  STARTTLS
}

// LDAP(Active Directory 포함) 연동 설정 — 싱글턴.
//
// 슈퍼관리자 시스템 환경 설정 화면에서만 수정 가능하며, bindPassword는 평문으로 저장하지
// 않고 AES-256-GCM으로 암호화해 보관한다(src/lib/crypto.ts). 화면에도 다시 노출하지 않는다.
model LdapConfig {
  id      String  @id @default("default")
  enabled Boolean @default(false)

  // ── 연결 ──
  host       String?
  port       Int            @default(389)
  encryption LdapEncryption @default(STARTTLS)
  // 사내 자체서명 인증서를 쓰는 경우에만 false. 운영에서 끄면 중간자 공격에 노출된다.
  verifyCert Boolean        @default(true)
  timeoutMs  Int            @default(5000)

  // ── 검색용 바인딩 계정 ──
  bindDn                String?
  bindPasswordEncrypted String? // AES-256-GCM 암호문. 절대 평문 저장/응답 금지.

  // ── 사용자 검색 ──
  baseDn           String?
  userSearchFilter String  @default("(&(objectClass=person)(uid={username}))")
  userSearchScope  String  @default("sub") // base | one | sub

  // ── 속성 매핑 (LDAP 속성명 → User 필드) ──
  attrEmail      String  @default("mail")
  attrName       String  @default("cn")
  attrEmployeeNo String? @default("employeeNumber")
  attrDepartment String? @default("departmentNumber")
  attrPosition   String? @default("title")

  // ── 동기화 정책 ──
  // 동기화로 새로 만들어진 계정에 기본 부여할 역할.
  defaultRole RoleType @default(MEMBER)
  // LDAP 검색 결과에서 사라진 계정 처리 — 삭제하지 않고 LEFT로 전환한다.
  // 과거 응답·소유 이력을 보존해야 하기 때문(감사/데이터베이스제작자 권리).
  deactivateMissing Boolean @default(true)

  lastSyncAt      DateTime?
  lastSyncResult  String? // 마지막 동기화 요약 (JSON 문자열)
  updatedAt       DateTime @updatedAt

  @@map("ldap_config")
}

model ShareRequest {
  id         String             @id @default(cuid())
  formId     String
  form       FormRegistry       @relation(fields: [formId], references: [id])
  fromUserId String
  fromUser   User               @relation("ShareRequestFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User               @relation("ShareRequestTo", fields: [toUserId], references: [id])
  status     ShareRequestStatus @default(PENDING)
  createdAt  DateTime           @default(now())

  @@index([formId])
  @@map("share_requests")
}

// ---------------------------------------------------------------------------
// 데이터베이스제작자 보호 (저작권법 제4장, 제91조~제98조)
// ---------------------------------------------------------------------------
// 저작권법상 "데이터베이스제작자"는 소재의 갱신·검증·보충에 인적·물적으로 상당한
// 투자를 한 자를 말하며(제2조 20호), 그 보호기간은 데이터베이스의 제작을 완료한
// 때로부터 5년이고, 상당한 투자에 의한 갱신 등이 있으면 그 갱신 부분에 한해
// 갱신 시점부터 다시 5년이 기산된다(제95조). 이 사실관계(제작완료일/갱신이력)를
// 소송·행정 절차에서 입증하려면 "언제, 무엇을, 얼마나" 갱신했는지가 구조화된
// 형태로 기록되어 있어야 하므로 별도 정형 테이블로 관리한다.
model DatabaseRegistration {
  id                    String   @id @default(cuid())
  // 데이터베이스제작자(제2조 20호) — 상당한 투자를 한 주체
  producerName          String
  // 최초 제작 완료일 — 제95조 제1항 보호기간(5년)의 기산점
  completedAt           DateTime
  // 가장 최근의 "상당한 투자"에 의한 갱신일 — 제95조 제2항에 따라 해당 갱신
  // 부분에 대한 보호기간이 이 시점부터 다시 5년 기산된다.
  lastSubstantialUpdate DateTime
  // 상당한 투자의 구체적 내역 (인적/물적 투자 근거 — 분쟁 시 소명 자료)
  investmentDescription String
  createdAt             DateTime @default(now())

  updateLogs DatabaseUpdateLog[]

  @@map("database_registrations")
}

// 개별 "상당한 투자" 갱신 이벤트 이력 — 매 갱신마다 5년 보호기간이 새로 발생하는
// 부분을 특정할 수 있도록 건별로 남긴다 (제95조 제2항: "그 갱신 등을 한 부분에 대하여").
model DatabaseUpdateLog {
  id             String               @id @default(cuid())
  registrationId String
  registration   DatabaseRegistration @relation(fields: [registrationId], references: [id])
  occurredAt     DateTime             @default(now())
  // 갱신 대상 범위 (예: "f-101 제출 데이터 전체", "폼 필드 스키마 일괄 마이그레이션")
  scope          String
  description    String
  performedBy    String

  @@index([registrationId])
  @@map("database_update_logs")
}
