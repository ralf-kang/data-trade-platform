# 로컬 개발용 환경변수 예시. 복사해서 사용하세요: cp .env.example .env
# docker-compose.yml 은 이 값들을 postgres/elasticsearch/app 컨테이너에 주입합니다.

# --- 정형 데이터베이스 (PostgreSQL) ---
POSTGRES_USER=webreport
POSTGRES_PASSWORD=webreport
POSTGRES_DB=webreport
# 로컬(비-Docker)에서 `npm run dev` 로 직접 띄울 때 Prisma가 사용하는 접속 문자열.
# Docker Compose로 띄울 때는 docker-compose.yml이 서비스명(postgres)으로 자동 구성하므로
# 이 값을 별도로 맞출 필요는 없지만, 로컬 psql 접속 편의를 위해 예시로 남겨둡니다.
DATABASE_URL="postgresql://webreport:webreport@localhost:5432/webreport?schema=public"

# --- 비정형 데이터베이스 (Elasticsearch) ---
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# --- nginx(web) 계층이 호스트에 노출할 포트 ---
WEB_PORT=80
